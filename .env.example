# Copy this file to .env and fill values.
# Never commit real credentials.

# Required: OAuth client from Google Cloud (same project with Sheets + Drive APIs enabled)
G_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
G_CLIENT_SECRET="your-google-oauth-client-secret"

# Required: Google account used for OAuth consent in this project
EMAIL="your-google-email@example.com"

# Optional: override default endpoint/host behavior if needed
# WORKSPACE_MCP_PORT="8000"
# WORKSPACE_MCP_HOST="127.0.0.1"
